    "titleAr": "التعارف الأول",
    "titleEn": "First introduction",
    "situation": "school",
    "characters": ["عُمَر", "لَيْلى"],
    "turns": [
      {
        "speaker": "عُمَر",
        "arabic": "مَرْحَبًا. أَنا عُمَر. ما اسْمُكِ؟",
        "translationEn": "Hello. I am Omar. What is your name?"
      },
      {
        "speaker": "لَيْلى",
        "arabic": "مَرْحَبًا. أَنا لَيْلى.",
        "translationEn": "Hello. I am Layla."
      },
      {
        "speaker": "عُمَر",
        "arabic": "تَشَرَّفْتُ بِمَعْرِفَتِكِ.",
        "translationEn": "Nice to meet you."
      }
    ],
    "targets": ["greetings", "name", "أنا"],
