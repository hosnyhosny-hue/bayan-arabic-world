// BAYAN Social uses trusted Next.js server routes with Firebase Admin.
// Deny direct client access by default.
match /bayan_social_posts/{document=**} { allow read, write: if false; }
match /bayan_social_comments/{document=**} { allow read, write: if false; }
match /bayan_social_reactions/{document=**} { allow read, write: if false; }
match /bayan_social_notifications/{document=**} { allow read, write: if false; }
match /bayan_social_follows/{document=**} { allow read, write: if false; }
