// Merge these collections into your existing firestore.rules.
// The API uses Firebase Admin. These client rules deny direct writes by default.
match /bayan_users/{uid} {
  allow read: if request.auth != null && (request.auth.uid == uid || request.auth.token.role in ['super_admin','admin','head_of_department']);
  allow write: if false;
}
match /bayan_settings/{schoolId} {
  allow read: if request.auth != null;
  allow write: if false;
}
match /bayan_media/{mediaId} {
  allow read: if request.auth != null;
  allow write: if false;
}
