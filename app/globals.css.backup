@import "tailwindcss";

:root {
  --green-dark: #006846;
  --green: #00a86b;
  --green-light: #dff8ec;
  --orange: #ff8200;
  --cream: #f8fbf5;
  --ink: #17372c;
  --muted: #71857c;
}

* {
  box-sizing: border-box;
}

html {
  background: var(--cream);
}

body {
  margin: 0;
  color: var(--ink);
  background: var(--cream);
  font-family:
    "IBM Plex Arabic",
    "IBM Plex Sans Arabic",
    "Segoe UI",
    Arial,
    sans-serif;
}

button,
a,
input,
textarea {
  font: inherit;
}

button,
a {
  -webkit-tap-highlight-color: transparent;
}

.home-world {
  position: relative;
  min-height: 100svh;
  overflow: hidden;
  background:
    radial-gradient(circle at 95% 5%, #c9fae5 0, transparent 34%),
    radial-gradient(circle at 5% 95%, #ffe4c2 0, transparent 33%),
    #f7faf4;
}

.background-orb {
  position: fixed;
  pointer-events: none;
  border-radius: 999px;
  filter: blur(80px);
  opacity: 0.45;
}

.background-orb-one {
  width: 330px;
  height: 330px;
  right: -100px;
  top: -100px;
  background: #66e3ae;
}

.background-orb-two {
  width: 400px;
  height: 400px;
  left: -130px;
  bottom: -150px;
  background: #ffc178;
}

.home-frame,
.section-frame,
.admin-frame {
  position: relative;
  width: min(1450px, calc(100% - 32px));
  margin: auto;
}

.home-frame {
  min-height: 100svh;
  display: flex;
  flex-direction: column;
  padding: 14px 0 10px;
}

.world-header {
  min-height: 66px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18px;
  padding: 10px 18px;
  border: 1px solid rgba(255, 255, 255, 0.9);
  border-radius: 24px;
  background: rgba(255, 255, 255, 0.86);
  box-shadow: 0 12px 35px rgba(21, 70, 48, 0.08);
  backdrop-filter: blur(18px);
}

.brand {
  display: flex;
  align-items: center;
  gap: 11px;
  color: var(--ink);
  text-decoration: none;
}

.brand-logo {
  width: 45px;
  height: 45px;
  display: grid;
  place-items: center;
  border-radius: 14px;
  color: white;
  background: linear-gradient(145deg, #08b476, #006a48);
  box-shadow: 0 8px 18px rgba(0, 111, 73, 0.26);
  font-size: 22px;
  font-weight: 900;
}

.brand strong,
.brand small {
  display: block;
}

.brand strong {
  font-size: 16px;
  line-height: 1.15;
}

.brand small {
  margin-top: 3px;
  color: #07835c;
  font-size: 8px;
  font-weight: 900;
  letter-spacing: 0.22em;
}

.header-actions {
  display: flex;
  align-items: center;
  gap: 8px;
}

.header-button {
  height: 40px;
  border: 0;
  border-radius: 12px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 7px;
  cursor: pointer;
  font-weight: 800;
  transition: 0.2s ease;
}

.header-button:hover {
  transform: translateY(-2px);
}

.sound-button {
  width: 40px;
  color: #ef6800;
  background: #fff2e4;
}

.language-button {
  padding: 0 14px;
  color: #00734f;
  background: #e8faf1;
}

.home-stage {
  flex: 1;
  min-height: 0;
  display: grid;
  grid-template-columns: minmax(355px, 0.82fr) minmax(650px, 1.65fr);
  align-items: center;
  gap: 18px;
  padding: 18px 0;
}

.hero-panel,
.apps-panel {
  min-height: 0;
  border-radius: 34px;
}

.hero-panel {
  position: relative;
  overflow: hidden;
  height: min(570px, calc(100svh - 130px));
  min-height: 500px;
  color: white;
  background: linear-gradient(145deg, #006946 0%, #008b5b 52%, #00c86c 100%);
  box-shadow: 0 28px 60px rgba(0, 94, 62, 0.23);
}

.hero-decoration {
  position: absolute;
  border-radius: 999px;
}

.hero-decoration-one {
  width: 270px;
  height: 270px;
  left: -110px;
  bottom: -90px;
  background: rgba(255, 184, 76, 0.22);
}

.hero-decoration-two {
  width: 260px;
  height: 260px;
  right: -80px;
  top: -110px;
  background: rgba(255, 255, 255, 0.09);
}

.hero-content {
  position: relative;
  z-index: 2;
  height: 100%;
  padding: 30px;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.hero-badge,
.section-school {
  width: fit-content;
  display: inline-flex;
  align-items: center;
  gap: 7px;
  padding: 8px 13px;
  border-radius: 999px;
  background: rgba(255, 255, 255, 0.15);
  font-size: 11px;
  font-weight: 900;
}

.hero-content h1 {
  margin: 24px 0 0;
  font-size: clamp(39px, 4vw, 59px);
  line-height: 1.15;
  letter-spacing: -0.045em;
}

.hero-content h1 span {
  display: block;
  color: #ffb34f;
}

.hero-content > p {
  max-width: 530px;
  margin: 20px 0 0;
  color: #eafff5;
  font-size: 14px;
  line-height: 2;
  font-weight: 600;
}

.mascot-card {
  margin-top: 25px;
  display: flex;
  align-items: center;
  gap: 14px;
  padding: 13px;
  border: 1px solid rgba(255, 255, 255, 0.13);
  border-radius: 20px;
  background: rgba(255, 255, 255, 0.11);
}

.mascot {
  flex: 0 0 auto;
  width: 61px;
  height: 61px;
  display: grid;
  place-items: center;
  border-radius: 18px;
  background: linear-gradient(145deg, #ffb236, #ff7800);
  box-shadow: 0 10px 25px rgba(94, 41, 0, 0.24);
  font-size: 34px;
}

.mascot-card strong,
.mascot-card span {
  display: block;
}

.mascot-card strong {
  font-size: 16px;
}

.mascot-card span {
  margin-top: 5px;
  color: #e6fff4;
  font-size: 11px;
  line-height: 1.7;
}

.hero-tags {
  margin-top: 20px;
  display: flex;
  flex-wrap: wrap;
  gap: 7px;
}

.hero-tags span {
  padding: 7px 11px;
  border-radius: 999px;
  background: rgba(255, 255, 255, 0.1);
  font-size: 10px;
  font-weight: 800;
}

.apps-panel {
  padding: 25px;
  background: rgba(255, 255, 255, 0.9);
  box-shadow: 0 28px 60px rgba(32, 59, 47, 0.11);
  backdrop-filter: blur(16px);
}

.apps-heading {
  margin-bottom: 17px;
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 20px;
}

.apps-heading small,
.content-title small,
.admin-heading small {
  display: block;
  color: var(--orange);
  font-size: 9px;
  font-weight: 1000;
  letter-spacing: 0.23em;
}

.apps-heading h2 {
  margin: 4px 0 0;
  font-size: 24px;
}

.admin-link {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 9px 12px;
  border-radius: 11px;
  color: #607168;
  background: #f0f5f2;
  text-decoration: none;
  font-size: 10px;
  font-weight: 900;
}

.apps-grid {
  display: grid;
  grid-template-columns: repeat(6, minmax(0, 1fr));
  gap: 19px 12px;
}

.app-item {
  min-width: 0;
  display: flex;
  align-items: center;
  flex-direction: column;
  text-align: center;
  color: var(--ink);
  text-decoration: none;
}

.app-icon {
  position: relative;
  overflow: hidden;
  width: min(88px, 100%);
  aspect-ratio: 1;
  display: grid;
  place-items: center;
  border-radius: 23px;
  box-shadow: 0 13px 23px rgba(20, 57, 43, 0.16);
  transition: transform 0.23s ease, box-shadow 0.23s ease;
}

.app-item:hover .app-icon {
  transform: translateY(-7px) scale(1.055) rotate(1.5deg);
  box-shadow: 0 19px 30px rgba(20, 57, 43, 0.22);
}

.app-glow {
  position: absolute;
  width: 60%;
  height: 60%;
  right: -15%;
  top: -17%;
  border-radius: 999px;
  background: rgba(255, 255, 255, 0.22);
}

.app-svg {
  position: relative;
  z-index: 2;
  width: 40%;
  height: 40%;
  color: white;
  stroke-width: 2.15;
}

.app-item strong {
  width: 100%;
  overflow: hidden;
  margin-top: 9px;
  font-size: 11px;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.app-item small {
  width: 100%;
  overflow: hidden;
  margin-top: 2px;
  color: #85988f;
  font-size: 7px;
  font-weight: 800;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.home-footer {
  min-height: 18px;
  padding: 0 7px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: #8ba097;
  font-size: 8px;
  font-weight: 800;
}

/* Internal pages */

.section-world {
  min-height: 100svh;
  padding: 14px 0 55px;
  background:
    radial-gradient(circle at 90% 0%, #d7f8e9 0, transparent 30%),
    #f7faf4;
}

.section-nav {
  margin: 15px 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.section-nav a {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  padding: 9px 14px;
  border-radius: 12px;
  color: #00734f;
  background: white;
  box-shadow: 0 7px 20px rgba(19, 76, 51, 0.08);
  text-decoration: none;
  font-size: 12px;
  font-weight: 900;
}

.section-nav > span {
  color: #83968d;
  font-size: 11px;
  font-weight: 800;
}

.section-hero {
  position: relative;
  overflow: hidden;
  min-height: 310px;
  padding: 45px;
  display: grid;
  grid-template-columns: 130px 1fr;
  align-items: center;
  gap: 35px;
  border-radius: 36px;
  color: white;
  box-shadow: 0 26px 55px rgba(0, 100, 66, 0.2);
}

.section-hero-orb {
  position: absolute;
  width: 400px;
  height: 400px;
  left: -170px;
  bottom: -270px;
  border-radius: 999px;
  background: rgba(255, 255, 255, 0.13);
}

.section-hero-icon {
  position: relative;
  width: 125px;
  height: 125px;
  display: grid;
  place-items: center;
  border-radius: 31px;
  background: rgba(255, 255, 255, 0.16);
  backdrop-filter: blur(12px);
}

.section-hero-icon svg {
  width: 58px;
  height: 58px;
}

.section-hero h1 {
  margin: 20px 0 0;
  font-size: clamp(42px, 6vw, 70px);
  line-height: 1.05;
}

.section-hero h2 {
  margin: 6px 0 0;
  color: #ffcf81;
  font-size: 19px;
}

.section-hero p {
  max-width: 760px;
  margin: 22px 0 0;
  color: rgba(255, 255, 255, 0.9);
  font-size: 15px;
  line-height: 1.9;
}

.section-statistics {
  margin-top: 18px;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 13px;
}

.section-statistics article {
  padding: 17px 20px;
  border: 1px solid #e8f2ec;
  border-radius: 20px;
  background: white;
  box-shadow: 0 12px 28px rgba(33, 67, 53, 0.06);
}

.section-statistics strong,
.section-statistics span {
  display: block;
}

.section-statistics strong {
  color: #009763;
  font-size: 27px;
}

.section-statistics span {
  margin-top: 2px;
  color: #7b8e85;
  font-size: 10px;
  font-weight: 800;
}

.content-section {
  margin-top: 18px;
  padding: 30px;
  border-radius: 30px;
  background: white;
  box-shadow: 0 20px 50px rgba(31, 66, 51, 0.07);
}

.content-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.content-title h2 {
  margin: 5px 0 0;
  font-size: 26px;
}

.content-title > svg {
  color: #00a36a;
}

.content-grid {
  margin-top: 23px;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 17px;
}

.content-card {
  min-height: 235px;
  padding: 22px;
  border: 1px solid #e2f1e9;
  border-radius: 24px;
  background: linear-gradient(145deg, #fbfffd, #f3faf6);
  transition: 0.23s ease;
}

.content-card:hover {
  transform: translateY(-5px);
  box-shadow: 0 17px 30px rgba(24, 77, 52, 0.09);
}

.content-card-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.content-number {
  width: 45px;
  height: 45px;
  display: grid;
  place-items: center;
  border-radius: 14px;
  color: white;
  font-size: 13px;
  font-weight: 900;
}

.content-tag {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  padding: 6px 9px;
  border-radius: 999px;
  color: #ce6800;
  background: #fff2df;
  font-size: 9px;
  font-weight: 900;
}

.content-card h3 {
  margin: 20px 0 0;
  font-size: 19px;
}

.content-card p {
  margin: 10px 0 0;
  color: #6b7e75;
  font-size: 12px;
  line-height: 1.85;
}

.content-card button {
  margin-top: 19px;
  padding: 0;
  border: 0;
  display: inline-flex;
  align-items: center;
  gap: 6px;
  color: #008b5b;
  background: transparent;
  cursor: pointer;
  font-size: 11px;
  font-weight: 900;
}

.section-callout {
  margin-top: 18px;
  padding: 20px;
  display: grid;
  grid-template-columns: auto 1fr auto;
  align-items: center;
  gap: 16px;
  border-radius: 25px;
  color: white;
  background: linear-gradient(135deg, #006c49, #00a569);
}

.small-mascot {
  width: 55px;
  height: 55px;
  font-size: 29px;
}

.section-callout strong {
  font-size: 17px;
}

.section-callout p {
  margin: 4px 0 0;
  color: #dffbef;
  font-size: 11px;
}

.section-callout a {
  padding: 11px 15px;
  border-radius: 12px;
  color: #006f4b;
  background: white;
  text-decoration: none;
  font-size: 11px;
  font-weight: 900;
}

/* Admin */

.admin-world {
  min-height: 100svh;
  padding: 14px 0 55px;
  background: #f3f6f4;
}

.admin-heading {
  margin-top: 18px;
  padding: 26px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-radius: 28px;
  color: white;
  background: linear-gradient(135deg, #142d25, #006e4c);
}

.admin-heading h1 {
  margin: 5px 0;
  font-size: 29px;
}

.admin-heading p {
  margin: 0;
  color: #d7f6e9;
  font-size: 12px;
}

.admin-stat-grid {
  margin-top: 17px;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 15px;
}

.admin-stat-grid article {
  padding: 21px;
  border-radius: 23px;
  background: white;
  box-shadow: 0 12px 30px rgba(26, 62, 47, 0.07);
}

.admin-stat-grid svg {
  color: #00a06a;
}

.admin-stat-grid strong,
.admin-stat-grid span {
  display: block;
}

.admin-stat-grid strong {
  margin-top: 13px;
  font-size: 32px;
}

.admin-stat-grid span {
  color: #778a81;
  font-size: 11px;
  font-weight: 800;
}

.admin-grid {
  margin-top: 17px;
  display: grid;
  grid-template-columns: 1.15fr 0.85fr;
  gap: 17px;
}

.upload-panel,
.quick-editor {
  padding: 25px;
  border-radius: 28px;
  background: white;
  box-shadow: 0 15px 40px rgba(26, 62, 47, 0.07);
}

.panel-title {
  display: flex;
  align-items: flex-start;
  gap: 12px;
}

.panel-title > svg {
  color: #009c67;
}

.panel-title h2 {
  margin: 0;
  font-size: 21px;
}

.panel-title p {
  margin: 5px 0 0;
  color: #7b8b84;
  font-size: 10px;
}

.upload-zone {
  min-height: 210px;
  margin-top: 21px;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  border: 2px dashed #b8e9d1;
  border-radius: 23px;
  color: #008e5e;
  background: #f3fdf8;
  cursor: pointer;
}

.upload-zone input {
  display: none;
}

.upload-zone strong {
  margin-top: 11px;
}

.upload-zone span {
  margin-top: 5px;
  color: #8a9b93;
  font-size: 9px;
}

.media-preview {
  margin-top: 16px;
}

.media-preview img,
.media-preview video {
  width: 100%;
  max-height: 260px;
  object-fit: cover;
  border-radius: 18px;
}

.media-preview strong {
  display: block;
  margin-top: 8px;
  font-size: 10px;
}

.quick-editor input,
.quick-editor textarea {
  width: 100%;
  margin-top: 18px;
  padding: 13px;
  border: 1px solid #dfeae4;
  border-radius: 13px;
  outline: 0;
  background: #fbfdfc;
}

.quick-editor textarea {
  resize: vertical;
}

.quick-editor input:focus,
.quick-editor textarea:focus {
  border-color: #00a96e;
}

.quick-editor button {
  width: 100%;
  margin-top: 13px;
  padding: 13px;
  border: 0;
  border-radius: 13px;
  color: white;
  background: #008e5e;
  cursor: pointer;
  font-weight: 900;
}

.not-found-page {
  min-height: 100svh;
  display: grid;
  place-content: center;
  text-align: center;
}

.not-found-page a {
  color: #008e5e;
}

/* Responsive */

@media (max-width: 1100px) {
  .home-world {
    overflow: auto;
  }

  .home-stage {
    grid-template-columns: 1fr;
  }

  .hero-panel {
    height: auto;
    min-height: 470px;
  }

  .apps-grid {
    grid-template-columns: repeat(4, 1fr);
  }

  .home-footer {
    padding: 10px 7px;
  }
}

@media (max-width: 720px) {
  .home-frame,
  .section-frame,
  .admin-frame {
    width: min(100% - 20px, 1450px);
  }

  .world-header {
    border-radius: 18px;
    padding: 8px 10px;
  }

  .brand-logo {
    width: 40px;
    height: 40px;
  }

  .brand strong {
    font-size: 13px;
  }

  .brand small {
    display: none;
  }

  .language-button {
    width: 40px;
    padding: 0;
    font-size: 0;
  }

  .home-stage {
    padding: 10px 0;
  }

  .hero-panel,
  .apps-panel {
    border-radius: 25px;
  }

  .hero-content {
    padding: 24px;
  }

  .hero-content h1 {
    font-size: 40px;
  }

  .apps-panel {
    padding: 20px 14px;
  }

  .apps-grid {
    grid-template-columns: repeat(3, 1fr);
    gap: 18px 9px;
  }

  .app-icon {
    width: 74px;
    border-radius: 20px;
  }

  .home-footer {
    display: none;
  }

  .section-hero {
    padding: 29px;
    grid-template-columns: 1fr;
  }

  .section-hero-icon {
    width: 80px;
    height: 80px;
  }

  .section-hero-icon svg {
    width: 39px;
    height: 39px;
  }

  .section-hero h1 {
    font-size: 43px;
  }

  .section-statistics,
  .content-grid,
  .admin-stat-grid,
  .admin-grid {
    grid-template-columns: 1fr;
  }

  .content-section {
    padding: 21px;
  }

  .section-callout {
    grid-template-columns: auto 1fr;
  }

  .section-callout a {
    grid-column: 1 / -1;
    text-align: center;
  }
}
